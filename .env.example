# Base PostgreSQL locale (utilisée aussi par docker compose)
POSTGRES_PASSWORD=change-this-local-database-password
DATABASE_URL=postgresql://novel_writer:change-this-local-database-password@127.0.0.1:5432/novel_writer

# Authentification mono-utilisateur : configurez votre adresse et un mot de passe long.
APP_EMAIL=vous@example.com
APP_PASSWORD=change-this-to-a-long-private-password
# Remplacez par une valeur aléatoire unique d'au moins 32 caractères.
AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Facultatif : clé OpenAI si vous choisissez ce fournisseur IA.
# OPENAI_API_KEY=
